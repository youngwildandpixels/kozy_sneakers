{%- comment -%}
  Google Reviews — met en avant des avis Google depuis des metaobjects.

  Metaobject recommande : google_review
  Champs : reviewer_name, rating, body, date, location, review_url, avatar
{%- endcomment -%}
{%- liquid
  assign source = section.settings.source
  assign metaobject_type = section.settings.metaobject_type | default: 'google_review'
  assign reviews_limit = section.settings.reviews_to_show
  assign google_reviews = shop.metaobjects[metaobject_type].values
  assign has_metaobject_reviews = false
  assign business_image = section.settings.business_image

  if source == 'metaobjects' and google_reviews != blank
    assign has_metaobject_reviews = true
  endif
-%}

<section class="google-reviews" id="GoogleReviews-{{ section.id }}" data-google-reviews-section>
  <div class="google-reviews__inner container">
    <aside class="google-reviews__summary" aria-label="{{ section.settings.average_rating }} sur 5 sur Google">
      <div class="google-reviews__business-media">
        {%- if business_image != blank -%}
          {{
            business_image
            | image_url: width: 160
            | image_tag:
              loading: 'lazy',
              widths: '80, 120, 160',
              sizes: '64px',
              class: 'google-reviews__business-img',
              alt: business_image.alt
          }}
        {%- else -%}
          <span class="google-reviews__business-fallback" aria-hidden="true">K</span>
        {%- endif -%}
      </div>
      <div class="google-reviews__business-copy">
        <p class="google-reviews__business-name" data-google-reviews-business>{{ section.settings.business_name }}</p>
        <img
          class="google-reviews__logo"
          src="https://cdn.shopify.com/s/files/1/0668/6700/3467/files/google_review.png?v=1788335407"
          alt="Google Reviews"
          width="116"
          height="20"
          loading="lazy"
        >
        <p class="google-reviews__count" data-google-reviews-count>{{ section.settings.review_count }} avis</p>
      </div>
    </aside>

    <div class="google-reviews__carousel">
      <button class="google-reviews__arrow google-reviews__arrow--prev" type="button" data-google-reviews-prev aria-label="Avis précédents">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <div class="google-reviews__track" data-google-reviews-track>
        <div class="google-reviews__list" data-google-reviews-list>
          {%- if has_metaobject_reviews -%}
            {%- for review in google_reviews limit: reviews_limit -%}
              {%- liquid
                assign reviewer_name = review.reviewer_name.value | default: review.reviewer_name
                assign rating = review.rating.value | default: review.rating | default: 5 | plus: 0
                assign body = review.body.value | default: review.body
                assign date = review.date.value | default: review.date
                assign location = review.location.value | default: review.location
                assign review_url = review.review_url.value | default: review.review_url
                assign avatar = review.avatar.value | default: review.avatar
              -%}
              <article class="google-review" {{ review.shopify_attributes }}>
                <div class="google-review__top">
                  <div class="google-review__author">
                    <div class="google-review__avatar">
                      {%- if avatar != blank -%}
                        {{
                          avatar
                          | image_url: width: 96
                          | image_tag:
                            loading: 'lazy',
                            widths: '48, 72, 96',
                            sizes: '48px',
                            alt: reviewer_name
                        }}
                      {%- else -%}
                        <span>{{ reviewer_name | default: 'Client Google' | slice: 0 | upcase }}</span>
                      {%- endif -%}
                    </div>
                    <div>
                      <h3 class="google-review__name">{{ reviewer_name | default: 'Client Google' }}</h3>
                      {%- if date != blank or location != blank -%}
                        <p class="google-review__meta">
                          {%- if date != blank -%}{{ date }}{%- endif -%}
                          {%- if date != blank and location != blank -%}<span aria-hidden="true"> · </span>{%- endif -%}
                          {%- if location != blank -%}{{ location }}{%- endif -%}
                        </p>
                      {%- endif -%}
                    </div>
                  </div>
                  <img
                    class="google-review__google"
                    src="https://cdn.shopify.com/s/files/1/0668/6700/3467/files/Logo-google-icon-PNG.png?v=1788269036"
                    alt=""
                    width="22"
                    height="22"
                    loading="lazy"
                    aria-hidden="true"
                  >
                </div>
                <div class="google-review__stars" aria-label="{{ rating }} sur 5">
                  {%- for i in (1..5) -%}
                    <span class="{% if i <= rating %}is-filled{% endif %}">★</span>
                  {%- endfor -%}
                </div>
                {%- if body != blank -%}
                  <div class="google-review__body">{{ body }}</div>
                {%- endif -%}
                {%- if review_url != blank -%}
                  <a href="{{ review_url }}" class="google-review__link" target="_blank" rel="noopener">Read More</a>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks limit: reviews_limit -%}
              {%- if block.type == 'review' -%}
                {%- assign rating = block.settings.rating | plus: 0 -%}
                <article class="google-review" {{ block.shopify_attributes }}>
                  <div class="google-review__top">
                    <div class="google-review__author">
                      <div class="google-review__avatar">
                        <span>{{ block.settings.reviewer_name | default: 'Client Google' | slice: 0 | upcase }}</span>
                      </div>
                      <div>
                        <h3 class="google-review__name">{{ block.settings.reviewer_name | default: 'Client Google' }}</h3>
                        {%- if block.settings.date != blank or block.settings.location != blank -%}
                          <p class="google-review__meta">
                            {%- if block.settings.date != blank -%}{{ block.settings.date }}{%- endif -%}
                            {%- if block.settings.date != blank and block.settings.location != blank -%}<span aria-hidden="true"> · </span>{%- endif -%}
                            {%- if block.settings.location != blank -%}{{ block.settings.location }}{%- endif -%}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                    <img
                      class="google-review__google"
                      src="https://cdn.shopify.com/s/files/1/0668/6700/3467/files/Logo-google-icon-PNG.png?v=1788269036"
                      alt=""
                      width="22"
                      height="22"
                      loading="lazy"
                      aria-hidden="true"
                    >
                  </div>
                  <div class="google-review__stars" aria-label="{{ rating }} sur 5">
                    {%- for i in (1..5) -%}
                      <span class="{% if i <= rating %}is-filled{% endif %}">★</span>
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.body != blank -%}
                    <div class="google-review__body">{{ block.settings.body }}</div>
                  {%- endif -%}
                  {%- if block.settings.review_url != blank -%}
                    <a href="{{ block.settings.review_url }}" class="google-review__link" target="_blank" rel="noopener">Read More</a>
                  {%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <button class="google-reviews__arrow google-reviews__arrow--next" type="button" data-google-reviews-next aria-label="Avis suivants">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </button>

      <div class="google-reviews__dots" data-google-reviews-dots aria-hidden="true">
        <button class="is-active" type="button" data-google-reviews-dot data-index="0" tabindex="-1"></button>
        <button type="button" data-google-reviews-dot data-index="1" tabindex="-1"></button>
        <button type="button" data-google-reviews-dot data-index="2" tabindex="-1"></button>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.google-reviews {
  padding: var(--space-12) 0;
  border-top: 1px solid var(--color-gray-100);
  background: var(--color-gray-100);
  overflow: hidden;
}

.shopify-section:has(+ .shopify-section .google-reviews) .brand-story {
  padding-bottom: 0;
}

.shopify-section:has(.brand-story) + .shopify-section .google-reviews {
  padding-top: var(--space-12);
  border-top: 0;
}

.google-reviews__inner {
  display: grid;
  grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
  align-items: center;
  gap: var(--space-6);
}

.google-reviews__summary {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.google-reviews__business-media {
  width: 64px;
  height: 64px;
  flex: 0 0 64px;
  overflow: hidden;
  border-radius: 4px;
  background: var(--color-gray-100);
}

.google-reviews__business-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.google-reviews__business-fallback {
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  background: var(--color-black);
  color: var(--color-white);
  font-size: 24px;
  font-weight: var(--font-weight-bold);
}

.google-reviews__business-copy {
  min-width: 0;
}

.google-reviews__business-name {
  margin: 0 0 2px;
  color: var(--color-black);
  font-size: 15px;
  font-weight: var(--font-weight-bold);
  line-height: 1.15;
}

.google-reviews__logo {
  display: block;
  width: min(116px, 100%);
  height: auto;
  margin: 4px 0;
}

.google-reviews__count {
  margin: 2px 0 0;
  color: var(--color-black);
  font-size: 15px;
  font-weight: var(--font-weight-bold);
  line-height: 1.2;
}

.google-reviews__carousel {
  position: relative;
  min-width: 0;
}

.google-reviews__track {
  overflow-x: auto;
  margin: -6px;
  padding: 6px 6px calc(var(--space-6) + 6px);
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.google-reviews__track::-webkit-scrollbar {
  display: none;
}

.google-reviews__list {
  display: flex;
  gap: var(--space-4);
}

.google-review {
  position: relative;
  display: flex;
  flex: 0 0 min(390px, calc((100% - (var(--space-4) * 2)) / 2.35));
  min-height: 238px;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-6);
  border: 1.5px solid var(--color-black);
  border-radius: 8px;
  background: var(--color-white);
  box-shadow: 0 3px 0 var(--color-black);
  color: var(--color-black);
  scroll-snap-align: start;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s, transform 0.15s;
}

.google-review:hover {
  transform: translateY(-1px);
  box-shadow: 0 5px 0 var(--color-black);
}

.google-review__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
}

.google-review__author {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.google-review__avatar {
  display: grid;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  place-items: center;
  overflow: hidden;
  border-radius: 50%;
  background: #0b63ce;
  color: var(--color-white);
  font-size: 20px;
  font-weight: var(--font-weight-medium);
}

.google-review__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.google-review__name {
  margin: 0;
  overflow: hidden;
  color: #333333;
  font-size: 17px;
  font-weight: var(--font-weight-bold);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.google-review__meta {
  margin: 2px 0 0;
  color: #777777;
  font-size: 16px;
  line-height: 1.35;
}

.google-review__google {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
  object-fit: contain;
}

.google-review__stars {
  display: flex;
  gap: 1px;
  color: var(--color-gray-300);
  font-size: 21px;
  line-height: 1;
}

.google-review__stars .is-filled {
  color: #fbbc04;
}

.google-review__body {
  display: -webkit-box;
  overflow: hidden;
  color: #333333;
  font-size: 17px;
  font-weight: var(--font-weight-regular);
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.google-review__body p {
  margin: 0;
}

.google-review__link {
  width: fit-content;
  margin-top: auto;
  color: #858585;
  font-size: 16px;
  font-weight: var(--font-weight-regular);
  line-height: 1.2;
}

.google-review__link:hover {
  color: var(--color-black);
  opacity: 1;
}

.google-reviews__arrow {
  position: absolute;
  top: calc(50% - 18px);
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 0.5px solid var(--color-gray-200);
  border-radius: 50%;
  background: var(--color-white);
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  color: var(--color-black);
  cursor: pointer;
  transform: translateY(-50%);
  transition: background 0.15s, opacity 0.15s, color 0.15s;
}

.google-reviews__arrow svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.google-reviews__arrow:hover {
  background: var(--color-black);
  color: var(--color-white);
  opacity: 1;
}

.google-reviews__arrow--prev {
  left: calc(var(--space-4) * -1);
}

.google-reviews__arrow--next {
  right: calc(var(--space-4) * -1);
}

.google-reviews__arrow:disabled {
  opacity: 0.25;
  cursor: default;
}

.google-reviews__dots {
  position: absolute;
  left: 50%;
  bottom: 0;
  display: flex;
  gap: 10px;
  transform: translateX(-50%);
}

.google-reviews__dots button {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #d2d2d2;
}

.google-reviews__dots button.is-active {
  background: #777777;
}

@media (max-width: 768px) {
  .google-reviews {
    padding: var(--space-8) 0;
  }

  .google-reviews__inner {
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .google-reviews__summary {
    justify-content: center;
    padding: 0 var(--space-5);
    text-align: left;
  }

  .google-reviews__track {
    margin: 0 calc(var(--container-padding) * -1);
    padding: 6px var(--container-padding) calc(var(--space-6) + 6px);
  }

  .google-review {
    flex-basis: min(82vw, 330px);
    min-height: 236px;
    padding: var(--space-5);
  }

  .google-reviews__arrow {
    display: none;
  }
}
{% endstylesheet %}

<script>
(function () {
  var section = document.getElementById('GoogleReviews-{{ section.id }}');
  if (!section) return;

  var config = {
    source: {{ section.settings.source | json }},
    apiKey: {{ section.settings.google_api_key | json }},
    placeId: {{ section.settings.google_place_id | json }},
    reviewsLimit: {{ section.settings.reviews_to_show | json }}
  };
  var track = section.querySelector('[data-google-reviews-track]');
  var list = section.querySelector('[data-google-reviews-list]');
  var prev = section.querySelector('[data-google-reviews-prev]');
  var next = section.querySelector('[data-google-reviews-next]');
  var dots = section.querySelectorAll('[data-google-reviews-dot]');
  if (!track || !prev || !next) return;

  function getMaxScroll() {
    return Math.max(0, track.scrollWidth - track.clientWidth);
  }

  function getStep() {
    var card = track.querySelector('.google-review');
    if (!card) return Math.round(track.clientWidth * 0.8);
    var gap = parseFloat(getComputedStyle(track.querySelector('.google-reviews__list')).columnGap) || 0;
    return Math.round(card.offsetWidth + gap);
  }

  function updateControls() {
    var maxScroll = getMaxScroll();
    var isScrollable = maxScroll > 1;
    prev.hidden = !isScrollable;
    next.hidden = !isScrollable;
    prev.disabled = track.scrollLeft <= 1;
    next.disabled = track.scrollLeft >= maxScroll - 1;

    var progress = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
    var activeIndex = Math.min(dots.length - 1, Math.round(progress * (dots.length - 1)));
    dots.forEach(function (dot, index) {
      dot.classList.toggle('is-active', index === activeIndex);
    });
  }

  prev.addEventListener('click', function () {
    track.scrollBy({ left: -getStep(), behavior: 'smooth' });
  });

  next.addEventListener('click', function () {
    track.scrollBy({ left: getStep(), behavior: 'smooth' });
  });

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      track.scrollTo({ left: getMaxScroll() * (Number(dot.dataset.index) / Math.max(1, dots.length - 1)), behavior: 'smooth' });
    });
  });

  track.addEventListener('scroll', updateControls);
  window.addEventListener('resize', updateControls);
  updateControls();

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (character) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[character];
    });
  }

  function getReviewText(review) {
    if (!review) return '';
    if (typeof review.text === 'string') return review.text;
    if (review.text && typeof review.text.text === 'string') return review.text.text;
    if (review.text && typeof review.text.toString === 'function') return review.text.toString();
    return '';
  }

  function getReviewAuthor(review) {
    if (!review) return 'Client Google';
    if (review.authorAttribution && review.authorAttribution.displayName) return review.authorAttribution.displayName;
    if (review.author_name) return review.author_name;
    if (review.authorName) return review.authorName;
    return 'Client Google';
  }

  function getReviewDate(review) {
    if (!review) return '';
    return review.relative_time_description || review.relativePublishTimeDescription || review.relative_publish_time_description || review.publishTime || '';
  }

  function renderStars(rating) {
    var normalizedRating = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
    var html = '';
    for (var index = 1; index <= 5; index += 1) {
      html += '<span class="' + (index <= normalizedRating ? 'is-filled' : '') + '">★</span>';
    }
    return html;
  }

  function renderReviews(place) {
    if (!list || !place || !Array.isArray(place.reviews) || place.reviews.length === 0) return;

    var businessName = section.querySelector('[data-google-reviews-business]');
    var reviewCount = section.querySelector('[data-google-reviews-count]');
    if (businessName && (place.displayName || place.name)) businessName.textContent = place.displayName || place.name;
    if (reviewCount && (place.userRatingCount || place.user_ratings_total)) reviewCount.textContent = (place.userRatingCount || place.user_ratings_total) + ' avis';

    list.innerHTML = place.reviews.slice(0, config.reviewsLimit || 3).map(function (review) {
      var author = getReviewAuthor(review);
      var initial = author.charAt(0).toUpperCase() || 'G';
      var rating = review.rating || 5;
      var text = getReviewText(review);
      var date = getReviewDate(review);
      var reviewUrl = review.googleMapsURI || review.googleMapsUri || review.author_url || place.url || place.googleMapsURI || place.googleMapsUri || '';
      var avatarUrl = review.profile_photo_url || '';

      return [
        '<article class="google-review">',
          '<div class="google-review__top">',
            '<div class="google-review__author">',
              '<div class="google-review__avatar">',
                avatarUrl ? '<img src="' + escapeHtml(avatarUrl) + '" alt="' + escapeHtml(author) + '" loading="lazy">' : '<span>' + escapeHtml(initial) + '</span>',
              '</div>',
              '<div>',
                '<h3 class="google-review__name">' + escapeHtml(author) + '</h3>',
                date ? '<p class="google-review__meta">' + escapeHtml(date) + '</p>' : '',
              '</div>',
            '</div>',
            '<img class="google-review__google" src="https://cdn.shopify.com/s/files/1/0668/6700/3467/files/Logo-google-icon-PNG.png?v=1788269036" alt="" width="22" height="22" loading="lazy" aria-hidden="true">',
          '</div>',
          '<div class="google-review__stars" aria-label="' + escapeHtml(rating) + ' sur 5">' + renderStars(rating) + '</div>',
          text ? '<div class="google-review__body"><p>' + escapeHtml(text) + '</p></div>' : '',
          reviewUrl ? '<a href="' + escapeHtml(reviewUrl) + '" class="google-review__link" target="_blank" rel="noopener">Read More</a>' : '',
        '</article>'
      ].join('');
    }).join('');

    updateControls();
  }

  function loadGoogleMaps() {
    if (window.google && window.google.maps && window.google.maps.places) return Promise.resolve();
    if (window.__kozyGoogleMapsPromise) return window.__kozyGoogleMapsPromise;

    window.__kozyGoogleMapsPromise = new Promise(function (resolve, reject) {
      var callbackName = '__kozyGoogleMapsReady';
      window[callbackName] = resolve;

      var script = document.createElement('script');
      script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(config.apiKey) + '&libraries=places&callback=' + callbackName + '&loading=async';
      script.async = true;
      script.onerror = reject;
      document.head.appendChild(script);
    });

    return window.__kozyGoogleMapsPromise;
  }

  if (config.source === 'google_places' && config.apiKey && config.placeId) {
    loadGoogleMaps()
      .then(function () {
        var service = new window.google.maps.places.PlacesService(document.createElement('div'));
        service.getDetails({
          placeId: config.placeId,
          fields: ['name', 'rating', 'user_ratings_total', 'reviews', 'url']
        }, function (place, status) {
          if (status !== window.google.maps.places.PlacesServiceStatus.OK || !place) {
            console.warn('Google Reviews could not be loaded', status);
            return;
          }

          renderReviews(place);
        });
      })
      .catch(function (error) {
        console.warn('Google Reviews could not be loaded', error);
      });
  }
})();
</script>

{% schema %}
{
  "name": "Google Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source des avis",
      "default": "metaobjects",
      "options": [
        { "value": "metaobjects", "label": "Metaobjects" },
        { "value": "blocks", "label": "Blocs manuels" },
        { "value": "google_places", "label": "Google Places API" }
      ]
    },
    {
      "type": "text",
      "id": "google_place_id",
      "label": "Google Place ID",
      "default": "ChIJ1S0GlaIb90cR5TgeezyMVj8"
    },
    {
      "type": "text",
      "id": "google_api_key",
      "label": "Google API key",
      "info": "Restreindre la clé au domaine du site et à Places API / Maps JavaScript API."
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Handle du metaobject",
