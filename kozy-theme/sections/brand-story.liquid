{%- comment -%} Brand Story — texte + image côte à côte {%- endcomment -%}

<section class="brand-story">
  <div class="brand-story__inner container">
    <div class="brand-story__status" data-brand-story-status aria-live="polite">
      <span class="brand-story__status-dot" data-brand-story-status-dot aria-hidden="true"></span>
      <span class="brand-story__status-copy">
        <span class="brand-story__status-state" data-brand-story-status-state>Horaires boutique</span>
        <span class="brand-story__status-hours">Lundi 14h-19h · Mardi au samedi 11h-19h</span>
      </span>
    </div>

    <div class="brand-story__text">
      {%- if section.settings.label != blank -%}
        <p class="brand-story__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="brand-story__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="brand-story__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        {%- liquid
          assign cta_url = section.settings.cta_link
          if section.settings.cta_page != blank
            assign cta_url = pages[section.settings.cta_page].url
          endif
        -%}
        <a href="{{ cta_url | default: '#' }}" class="btn btn--primary brand-story__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    <div class="brand-story__media" aria-label="Photos de la boutique Kozy Sneakers">
      {%- assign boutique_images = 'DSC01421.webp,DSC00077.webp,DSC02149.webp,DSC02387.webp' | split: ',' -%}
      {%- for boutique_image in boutique_images -%}
        {%- assign image_src = 'https://kozysneakers.com/cdn/shop/files/' | append: boutique_image | append: '?v=1782305377' -%}
        <img
          src="{{ image_src }}&width=900"
          srcset="{{ image_src }}&width=480 480w, {{ image_src }}&width=720 720w, {{ image_src }}&width=900 900w"
          sizes="(max-width: 768px) calc(100vw - 88px), 520px"
          alt="Boutique Kozy Sneakers"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          width="900"
          height="1125"
          class="brand-story__img"
        >
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.brand-story {
  padding: var(--space-16) var(--container-padding);
  background: var(--color-gray-100);
}

.brand-story__inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-areas: "media text";
  gap: 0;
  align-items: stretch;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0;
  background: var(--color-black);
  color: var(--color-white);
}

.brand-story__status {
  position: absolute;
  top: var(--space-5);
  left: var(--space-5);
  z-index: 2;
  display: inline-flex;
  align-items: flex-start;
  gap: 10px;
  max-width: min(320px, calc(100% - var(--space-10)));
  padding: 10px 14px;
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 8px;
  background: rgba(0,0,0,0.58);
  color: var(--color-white);
  backdrop-filter: blur(8px);
}

.brand-story__status-dot {
  width: 9px;
  height: 9px;
  flex: 0 0 9px;
  margin-top: 4px;
  border-radius: 50%;
  background: #ff4d4d;
}

.brand-story__status-dot.is-open {
  background: #26d96c;
  box-shadow: 0 0 0 0 rgba(38,217,108,0.65);
  animation: brand-story-status-pulse 1.4s infinite;
}

.brand-story__status-copy {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.brand-story__status-state {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  text-transform: uppercase;
}

.brand-story__status-hours {
  color: rgba(255,255,255,0.78);
  font-size: 11px;
  font-weight: var(--font-weight-medium);
  line-height: 1.25;
}

.brand-story__label {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--color-gray-300);
  margin-bottom: var(--space-3);
}

.brand-story__text {
  grid-area: text;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: clamp(var(--space-8), 7vw, var(--space-16));
  background: var(--color-black);
}

.brand-story__title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  line-height: 1.0;
  letter-spacing: 0;
  margin-bottom: var(--space-6);
  color: var(--color-white);
}

.brand-story__body {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-light);
  color: var(--color-white);
  line-height: 1.3;
  margin-bottom: var(--space-8);
}

.brand-story__cta {
  align-self: flex-start;
  background: var(--color-white);
  color: var(--color-black);
  border-color: var(--color-white);
}

.brand-story__cta:hover {
  background: transparent;
  color: var(--color-white);
  opacity: 1;
}

.brand-story__media {
  grid-area: media;
  position: relative;
  min-height: 520px;
  overflow: hidden;
  background: var(--color-gray-100);
}

.brand-story__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0;
  animation: brand-story-slideshow 16s infinite;
  transition: opacity 0.6s ease;
}

.brand-story__img:nth-child(1) { animation-delay: 0s; }
.brand-story__img:nth-child(2) { animation-delay: 4s; }
.brand-story__img:nth-child(3) { animation-delay: 8s; }
.brand-story__img:nth-child(4) { animation-delay: 12s; }

@keyframes brand-story-slideshow {
  0%, 22% { opacity: 1; }
  25%, 97% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes brand-story-status-pulse {
  0% { box-shadow: 0 0 0 0 rgba(38,217,108,0.65); }
  70% { box-shadow: 0 0 0 8px rgba(38,217,108,0); }
  100% { box-shadow: 0 0 0 0 rgba(38,217,108,0); }
}

@media (max-width: 768px) {
  .brand-story { padding: var(--space-12) 0; }
  .brand-story__inner {
    grid-template-columns: 1fr;
    grid-template-areas:
      "media"
      "text";
    padding: 0;
  }
  .brand-story__status {
    top: var(--space-5);
    left: var(--space-5);
    right: var(--space-5);
    max-width: none;
  }
  .brand-story__text {
    padding: var(--space-8) var(--space-6);
  }
  .brand-story__title { font-size: var(--font-size-h1); }
  .brand-story__media {
    min-height: 0;
    aspect-ratio: 4 / 5;
  }
}
{% endstylesheet %}

<script>
(function () {
  var section = document.querySelector('.brand-story');
  if (!section) return;

  var status = section.querySelector('[data-brand-story-status]');
  var state = section.querySelector('[data-brand-story-status-state]');
  var dot = section.querySelector('[data-brand-story-status-dot]');
  if (!status || !state || !dot) return;

  function getParisDate() {
    return new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Paris' }));
  }

  function formatHour(hour) {
    return hour + 'h';
  }

  function getNextOpening(day, hour) {
    if (day === 0) return { label: 'demain', hour: 14 };
    if (day === 1 && hour < 14) return { label: "aujourd'hui", hour: 14 };
    if (day >= 2 && day <= 6 && hour < 11) return { label: "aujourd'hui", hour: 11 };
    if (day >= 1 && day <= 5) return { label: 'demain', hour: 11 };
    return { label: 'lundi', hour: 14 };
  }

  function updateStatus() {
    var now = getParisDate();
    var day = now.getDay();
    var hour = now.getHours() + (now.getMinutes() / 60);
    var isOpen = false;

    if (day === 1) {
      isOpen = hour >= 14 && hour < 19;
    } else if (day >= 2 && day <= 6) {
      isOpen = hour >= 11 && hour < 19;
    }

    dot.classList.toggle('is-open', isOpen);
    status.classList.toggle('is-open', isOpen);

    if (isOpen) {
      state.textContent = 'Ouvert en ce moment';
      return;
    }

    var nextOpening = getNextOpening(day, hour);
    state.textContent = 'Fermé, rouvre ' + nextOpening.label + ' à ' + formatHour(nextOpening.hour);
  }

  updateStatus();
  window.setInterval(updateStatus, 60000);
})();
</script>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "settings": [
    { "type": "text",         "id": "label",     "label": "Label",      "default": "Notre histoire" },
    { "type": "text",         "id": "title",     "label": "Titre",      "default": "The Last Step" },
    { "type": "richtext",     "id": "text",      "label": "Texte",      "default": "<p>Présentation de la boutique.</p>" },
    { "type": "text",         "id": "cta_label", "label": "Texte CTA",  "default": "En savoir plus" },
    { "type": "page",         "id": "cta_page",  "label": "Page CTA" },
    { "type": "url",          "id": "cta_link",  "label": "Lien CTA manuel" },
    { "type": "image_picker", "id": "image",     "label": "Image" }
  ],
  "presets": [{ "name": "Brand Story" }]
}
{% endschema %}
