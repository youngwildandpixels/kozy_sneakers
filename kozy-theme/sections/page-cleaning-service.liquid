{%- comment -%} Page Cleaning Service — page nettoyage sneakers {%- endcomment -%}

<section class="cleaning-page" id="cleaning-page-{{ section.id }}">
  <div class="cleaning-page__hero container">
    <div class="cleaning-page__hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cleaning-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="cleaning-page__title">{{ section.settings.title | default: 'Nettoyage sneakers' }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="cleaning-page__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
      <div class="cleaning-page__actions">
        {%- if section.settings.primary_cta_label != blank -%}
          <a href="{{ section.settings.primary_cta_link | default: routes.root_url }}" class="cleaning-page__button cleaning-page__button--primary">
            {{ section.settings.primary_cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a href="{{ section.settings.secondary_cta_link | default: routes.root_url }}" class="cleaning-page__button">
            {{ section.settings.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="cleaning-page__hero-panel">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1200 }}"
          srcset="{{ section.settings.hero_image | image_url: width: 700 }} 700w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 768px) 100vw, 44vw"
          alt="{{ section.settings.title | escape }}"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
          loading="eager"
        >
      {%- else -%}
        <div class="cleaning-page__hero-placeholder">
          <span>Kozy Care</span>
          <strong>Sneaker cleaning</strong>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="cleaning-page__steps container">
    <div class="cleaning-step">
      <span class="cleaning-step__index">01</span>
      <h2>Dépose ta paire</h2>
      <p>En boutique, avec un diagnostic rapide selon la matière et l’état général.</p>
    </div>
    <div class="cleaning-step">
      <span class="cleaning-step__index">02</span>
      <h2>Nettoyage adapté</h2>
      <p>Mesh, cuir, daim, nubuck ou matières spécifiques : chaque paire reçoit le bon traitement.</p>
    </div>
    <div class="cleaning-step">
      <span class="cleaning-step__index">03</span>
      <h2>Récupération propre</h2>
      <p>On te prévient dès que ta paire est prête à repartir.</p>
    </div>
  </div>

  <div class="cleaning-gallery container" data-cleaning-gallery>
    <div class="cleaning-gallery__head">
      <p class="cleaning-page__eyebrow">{{ section.settings.gallery_eyebrow | default: 'Atelier Kozy' }}</p>
      <h2>{{ section.settings.gallery_title | default: 'Une paire, un soin adapté' }}</h2>
      {%- if section.settings.gallery_text != blank -%}
        <div>{{ section.settings.gallery_text }}</div>
      {%- endif -%}
    </div>

    <div class="cleaning-gallery__shell">
      <div class="cleaning-gallery__track" data-cleaning-gallery-track>
        {%- if section.settings.gallery_image_1 != blank -%}
          <figure class="cleaning-gallery__slide">
            <img
              src="{{ section.settings.gallery_image_1 | image_url: width: 1400 }}"
              srcset="{{ section.settings.gallery_image_1 | image_url: width: 800 }} 800w, {{ section.settings.gallery_image_1 | image_url: width: 1400 }} 1400w"
              sizes="(max-width: 768px) 100vw, 70vw"
              alt="{{ section.settings.gallery_caption_1 | escape }}"
              width="{{ section.settings.gallery_image_1.width }}"
              height="{{ section.settings.gallery_image_1.height }}"
              loading="lazy"
            >
            {%- if section.settings.gallery_caption_1 != blank -%}
              <figcaption>{{ section.settings.gallery_caption_1 }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- if section.settings.gallery_image_2 != blank -%}
          <figure class="cleaning-gallery__slide">
            <img
              src="{{ section.settings.gallery_image_2 | image_url: width: 1400 }}"
              srcset="{{ section.settings.gallery_image_2 | image_url: width: 800 }} 800w, {{ section.settings.gallery_image_2 | image_url: width: 1400 }} 1400w"
              sizes="(max-width: 768px) 100vw, 70vw"
              alt="{{ section.settings.gallery_caption_2 | escape }}"
              width="{{ section.settings.gallery_image_2.width }}"
              height="{{ section.settings.gallery_image_2.height }}"
              loading="lazy"
            >
            {%- if section.settings.gallery_caption_2 != blank -%}
              <figcaption>{{ section.settings.gallery_caption_2 }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- if section.settings.gallery_image_1 == blank and section.settings.gallery_image_2 == blank -%}
          <figure class="cleaning-gallery__slide cleaning-gallery__slide--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'cleaning-gallery__placeholder' }}
            <figcaption>Ajoute une première photo</figcaption>
          </figure>
          <figure class="cleaning-gallery__slide cleaning-gallery__slide--placeholder">
            {{ 'product-2' | placeholder_svg_tag: 'cleaning-gallery__placeholder' }}
            <figcaption>Ajoute une deuxième photo</figcaption>
          </figure>
        {%- endif -%}
      </div>

      <div class="cleaning-gallery__controls">
        <button type="button" class="cleaning-gallery__button" aria-label="Photo précédente" data-cleaning-gallery-prev>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button type="button" class="cleaning-gallery__button" aria-label="Photo suivante" data-cleaning-gallery-next>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="cleaning-pricing container">
    <div class="cleaning-pricing__head">
      <p class="cleaning-page__eyebrow">Grille tarifaire</p>
      <h2>Entretien sneakers, sacs et accessoires</h2>
    </div>

    <div class="cleaning-pricing__grid">
      <article class="cleaning-price-card cleaning-price-card--featured">
        <h3>L’entretien de la sneakers</h3>
        <ul>
          <li>
            <span>Clean classique <small>mesh / tissu / cuir</small></span>
            <strong>30€</strong>
          </li>
          <li>
            <span>Clean premium <small>daim / nubuck</small></span>
            <strong>35€</strong>
          </li>
          <li>
            <span>Retouche couleur / déjaunissement semelle</span>
            <strong>À partir de 10€</strong>
          </li>
        </ul>
      </article>

      <article class="cleaning-price-card">
        <h3>L’entretien du sac à main</h3>
        <ul>
          <li>
            <span>Clean sacoche</span>
            <strong>30€</strong>
          </li>
          <li>
            <span>Clean sac en cuir</span>
            <strong>40€</strong>
          </li>
          <li>
            <span>Sac avec matière spécifique</span>
            <strong>50€</strong>
          </li>
        </ul>
      </article>

      <article class="cleaning-price-card">
        <h3>Accessoires</h3>
        <ul>
          <li>
            <span>Imperméabilisant</span>
            <strong>10€</strong>
          </li>
          <li>
            <span>Embauchoir</span>
            <strong>10€</strong>
          </li>
          <li>
            <span>Lacets</span>
            <strong>10€</strong>
          </li>
        </ul>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
.cleaning-page {
  background: #fdfffc;
  color: var(--color-black);
}

.cleaning-page__hero {
  display: grid;
  grid-template-columns: minmax(0, 0.94fr) minmax(360px, 0.76fr);
  gap: var(--space-12);
  align-items: stretch;
  padding-top: var(--space-16);
  padding-bottom: var(--space-16);
}

.cleaning-page__hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 560px;
}

.cleaning-page__eyebrow {
  color: var(--color-gray-500);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1.7px;
  margin: 0 0 var(--space-4);
  text-transform: uppercase;
}

.cleaning-page__title {
  max-width: 860px;
  font-size: clamp(32px, 6vw, 72px);
  font-weight: var(--font-weight-bold);
  line-height: 1.0;
  letter-spacing: -1px;
  margin: 0;
  text-transform: uppercase;
}

.cleaning-page__intro {
  max-width: 560px;
  color: var(--color-gray-700);
  font-size: 18px;
  line-height: 1.45;
  margin-top: var(--space-8);
}

.cleaning-page__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-8);
}

.cleaning-page__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  border: 1.5px solid var(--color-black);
  border-radius: 9999px;
  color: var(--color-black);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1.5px;
  padding: 0 24px;
  text-transform: uppercase;
  transition: background 0.2s ease, color 0.2s ease;
}

.cleaning-page__button--primary,
.cleaning-page__button:hover {
  background: var(--color-black);
  color: var(--color-white);
  opacity: 1;
}

.cleaning-page__button--primary:hover {
  background: transparent;
  color: var(--color-black);
}

.cleaning-page__hero-panel {
  min-height: 560px;
  overflow: hidden;
  background: #101010;
}

.cleaning-page__hero-panel img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cleaning-page__hero-placeholder {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100%;
  padding: var(--space-8);
  background: linear-gradient(160deg, #101010 0%, #2a2a2a 100%);
  color: var(--color-white);
}

.cleaning-page__hero-placeholder span {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.cleaning-page__hero-placeholder strong {
  max-width: 420px;
  font-size: clamp(42px, 5vw, 76px);
  font-weight: var(--font-weight-black);
  line-height: 0.92;
  text-transform: uppercase;
}

.cleaning-page__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--color-black);
  border-bottom: 1px solid var(--color-black);
}

.cleaning-step {
  min-height: 220px;
  padding: var(--space-8);
  border-right: 1px solid var(--color-black);
}

.cleaning-step:last-child {
  border-right: 0;
}

.cleaning-step__index {
  display: block;
  color: var(--color-gray-500);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--space-8);
}

.cleaning-step h2 {
  font-size: clamp(26px, 3.2vw, 42px);
  font-weight: var(--font-weight-bold);
  line-height: 1.04;
  letter-spacing: -0.4px;
  margin: 0 0 var(--space-4);
  text-transform: uppercase;
}

.cleaning-step p {
  color: var(--color-gray-700);
  font-size: 15px;
  line-height: 1.45;
  max-width: 340px;
}

.cleaning-gallery {
  display: grid;
  grid-template-columns: minmax(240px, 0.45fr) minmax(0, 1fr);
  gap: var(--space-10);
  align-items: start;
  padding-top: var(--space-20);
}

.cleaning-gallery__head h2 {
  font-size: clamp(28px, 3.4vw, 44px);
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: 0;
  margin: 0 0 var(--space-5);
  text-transform: none;
}

.cleaning-gallery__head div {
  color: var(--color-gray-700);
  font-size: 16px;
  line-height: 1.45;
  max-width: 420px;
}

.cleaning-gallery__shell {
  display: grid;
  gap: var(--space-4);
  min-width: 0;
}

.cleaning-gallery__track {
  display: flex;
  gap: 2px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.cleaning-gallery__track::-webkit-scrollbar {
  display: none;
}

.cleaning-gallery__slide {
  position: relative;
  flex: 0 0 min(780px, 100%);
  min-height: 520px;
  overflow: hidden;
  background: var(--color-gray-100);
  scroll-snap-align: start;
}

.cleaning-gallery__slide img,
.cleaning-gallery__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cleaning-gallery__slide figcaption {
  position: absolute;
  left: var(--space-5);
  bottom: var(--space-5);
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  background: rgba(253, 255, 252, 0.92);
  color: var(--color-black);
  font-size: 13px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1px;
  padding: 0 12px;
  text-transform: uppercase;
}

.cleaning-gallery__controls {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
}

.cleaning-gallery__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid var(--color-black);
  border-radius: 50%;
  color: var(--color-black);
  transition: background 0.2s ease, color 0.2s ease;
}

.cleaning-gallery__button:hover {
  background: var(--color-black);
  color: var(--color-white);
}

.cleaning-pricing {
  padding-top: var(--space-20);
  padding-bottom: var(--space-20);
}

.cleaning-pricing__head {
  display: grid;
  grid-template-columns: minmax(0, 0.48fr) minmax(0, 1fr);
  gap: var(--space-8);
  align-items: end;
  margin-bottom: var(--space-10);
}

.cleaning-pricing__head h2 {
  max-width: 880px;
  font-size: clamp(28px, 3.4vw, 44px);
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: 0;
  margin: 0;
  text-transform: none;
}

.cleaning-pricing__grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr 0.86fr;
  gap: 2px;
  background: var(--color-black);
  border: 2px solid var(--color-black);
}

.cleaning-price-card {
  display: flex;
  flex-direction: column;
  min-height: 520px;
  background: #fdfffc;
  padding: var(--space-8);
}

.cleaning-price-card--featured {
  background: var(--color-black);
  color: var(--color-white);
}

.cleaning-price-card h3 {
  border-bottom: 1px solid currentColor;
  font-size: clamp(28px, 3.8vw, 58px);
  font-weight: var(--font-weight-bold);
  line-height: 0.98;
  margin: 0 0 var(--space-8);
  padding-bottom: var(--space-4);
  text-transform: lowercase;
}

.cleaning-price-card ul {
  display: grid;
  gap: var(--space-8);
}

.cleaning-price-card li {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-6);
  align-items: start;
}

.cleaning-price-card span,
.cleaning-price-card strong {
  font-size: clamp(18px, 2.2vw, 30px);
  font-weight: var(--font-weight-medium);
  line-height: 1.15;
}

.cleaning-price-card small {
  display: block;
  color: inherit;
  font-size: 0.72em;
  margin-top: 4px;
  opacity: 0.78;
}

.cleaning-price-card strong {
  white-space: nowrap;
}

@media (max-width: 1024px) {
  .cleaning-page__hero {
    grid-template-columns: 1fr;
  }

  .cleaning-page__hero-copy,
  .cleaning-page__hero-panel {
    min-height: auto;
  }

  .cleaning-page__hero-panel {
    aspect-ratio: 16 / 10;
  }

  .cleaning-pricing__grid {
    grid-template-columns: 1fr;
  }

  .cleaning-gallery {
    grid-template-columns: 1fr;
  }

  .cleaning-price-card {
    min-height: auto;
  }
}

@media (max-width: 768px) {
  .cleaning-page__hero {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
  }

  .cleaning-page__title {
    font-size: clamp(32px, 10vw, 48px);
  }

  .cleaning-page__intro {
    font-size: 16px;
  }

  .cleaning-page__steps {
    grid-template-columns: 1fr;
  }

  .cleaning-step {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--color-black);
    padding: var(--space-6) 0;
  }

  .cleaning-step:last-child {
    border-bottom: 0;
  }

  .cleaning-pricing {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .cleaning-gallery {
    padding-top: var(--space-12);
  }

  .cleaning-step h2 {
    font-size: clamp(24px, 7vw, 34px);
  }

  .cleaning-pricing__head h2,
  .cleaning-gallery__head h2 {
    font-size: clamp(26px, 7vw, 34px);
  }

  .cleaning-gallery__slide {
    flex-basis: 100%;
    min-height: 420px;
  }

  .cleaning-pricing__head {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .cleaning-price-card {
    padding: var(--space-6);
  }

  .cleaning-price-card li {
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .cleaning-price-card strong {
    white-space: normal;
  }
}
{% endstylesheet %}

<script>
(function () {
  var section = document.getElementById('cleaning-page-{{ section.id }}');
  if (!section) return;

  var gallery = section.querySelector('[data-cleaning-gallery]');
  if (!gallery) return;

  var track = gallery.querySelector('[data-cleaning-gallery-track]');
  var prev = gallery.querySelector('[data-cleaning-gallery-prev]');
  var next = gallery.querySelector('[data-cleaning-gallery-next]');
  if (!track || !prev || !next) return;

  function scrollBySlide(direction) {
    var slide = track.querySelector('.cleaning-gallery__slide');
    var amount = slide ? slide.getBoundingClientRect().width + 2 : track.clientWidth;
    track.scrollBy({ left: amount * direction, behavior: 'smooth' });
  }

  prev.addEventListener('click', function () { scrollBySlide(-1); });
  next.addEventListener('click', function () { scrollBySlide(1); });
})();
</script>

