{%- comment -%}
  Paramètres :
  - product : objet product Shopify
  - show_vendor : boolean
  - show_quick_add : boolean (pill "Achat express" en hover)
  - show_secondary_image : boolean (affiche la 2e image en hover)
  - lazy : boolean (lazy-load image)
{%- endcomment -%}
{%- liquid
  assign has_sale = false
  if product.compare_at_price > product.price
    assign has_sale = true
  endif

  assign fulfillment_type = product.metafields.custom.fulfillment_type.value | default: product.metafields.custom.fulfillment_type
  assign fulfillment_type_downcase = fulfillment_type | downcase
  assign is_partner_sourced = false
  if fulfillment_type_downcase == 'scraper' or fulfillment_type_downcase == 'partner' or fulfillment_type_downcase == 'revendeur'
    assign is_partner_sourced = true
  endif
  if product.tags contains 'stockx-sync' or product.tags contains 'scraper' or product.tags contains 'livraison-5-12' or product.tags contains 'revendeur-partenaire'
    assign is_partner_sourced = true
  endif

  assign pickup_available = false
  if product.available and is_partner_sourced == false
    assign pickup_available = true
  endif

  assign is_new_product = false
  assign is_best_seller_product = false
  assign is_top_sales_product = false
  for collection in product.collections
    if collection.handle == 'nouveautes' or collection.handle == 'nouveaute' or collection.handle == 'new'
      assign is_new_product = true
    endif
    if collection.handle == 'best-seller' or collection.handle == 'best-sellers' or collection.handle == 'best-selelr' or collection.handle == 'best-selelrs' or collection.handle == 'meilleures-ventes'
      assign is_best_seller_product = true
    endif
    if collection.handle == 'top-ventes' or collection.handle == 'top-vente' or collection.handle == 'top-sales'
      assign is_top_sales_product = true
    endif
  endfor
  if product.tags contains 'best-seller' or product.tags contains 'best seller' or product.tags contains 'best-sellers' or product.tags contains 'best-selelr' or product.tags contains 'best selelr'
    assign is_best_seller_product = true
  endif
  if product.tags contains 'top-ventes' or product.tags contains 'top vente' or product.tags contains 'top-vente'
    assign is_top_sales_product = true
  endif

  assign is_limited_product = false
  if product.tags contains 'edition-limitee' or product.tags contains 'édition limitée' or product.tags contains 'rare' or product.tags contains 'cote' or product.tags contains 'coté'
    assign is_limited_product = true
  endif

  assign secondary_image = blank
  if show_secondary_image and product.images.size > 1
    assign secondary_image = product.images[1]
  endif
-%}
<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media{% if secondary_image != blank %} product-card__media--has-secondary{% endif %}">
      {%- if has_sale -%}
        <span class="badge badge--promo">PROMO</span>
      {%- endif -%}
      <div class="product-card__stickers product-card__stickers--left" aria-label="Informations produit">
        {%- if is_limited_product -%}
          <span class="product-card__pill">Edition limitée</span>
        {%- elsif is_best_seller_product -%}
          <span class="product-card__pill product-card__pill--best">Best seller</span>
        {%- elsif is_top_sales_product -%}
          <span class="product-card__pill">Top ventes</span>
        {%- elsif is_new_product -%}
          <span class="product-card__pill">Nouveauté</span>
        {%- elsif pickup_available -%}
          <span class="product-card__pill">Dispo en boutique</span>
        {%- endif -%}
      </div>
      {%- unless is_partner_sourced -%}
        <div class="product-card__stickers product-card__stickers--right" aria-label="Livraison">
          <span class="product-card__pill">24/48h</span>
        </div>
      {%- endunless -%}
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w"
          sizes="(max-width: 768px) 50vw, 25vw"
          alt="{{ product.featured_image.alt | escape }}"
          loading="{{ lazy | default: 'lazy' }}"
          width="600"
          height="545"
          class="product-card__img product-card__img--primary"
        >
        {%- if secondary_image != blank -%}
          <img
            src="{{ secondary_image | image_url: width: 600 }}"
            srcset="{{ secondary_image | image_url: width: 400 }} 400w, {{ secondary_image | image_url: width: 600 }} 600w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="{{ secondary_image.alt | escape }}"
            loading="lazy"
            width="600"
            height="545"
            class="product-card__img product-card__img--secondary"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
      {%- endif -%}
      {%- if show_quick_add -%}
        <span class="product-card__quick-add" aria-hidden="true">Achat express</span>
      {%- endif -%}
    </div>
    <div class="product-card__info">
      {%- if show_vendor and product.vendor != blank -%}
        <p class="product-card__brand">{{ product.vendor }}</p>
      {%- endif -%}
      <p class="product-card__name">{{ product.title }}</p>
      <div class="product-card__prices">
        <span class="product-card__price{% if has_sale %} product-card__price--sale{% endif %}">
          {{ product.price | money_without_trailing_zeros }}
        </span>
        {%- if has_sale -%}
          <span class="product-card__price product-card__price--compare">
            {{ product.compare_at_price | money_without_trailing_zeros }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </a>
</article>
