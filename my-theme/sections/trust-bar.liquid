{%- comment -%}
  Trust Bar — 4 icônes de confiance : Click&Collect / Authentiques / Livraison / SAV
{%- endcomment -%}

<div class="trust-bar page-width">
  {%- for block in section.blocks -%}
    <div class="trust-bar__item" {{ block.shopify_attributes }}>
      <div class="trust-bar__icon" aria-hidden="true">
        {%- case block.settings.icon -%}
          {%- when 'store' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          {%- when 'badge' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          {%- when 'headphones' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/>
            </svg>
          {%- when 'check' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
        {%- endcase -%}
      </div>
      <div class="trust-bar__text">
        {%- if block.settings.title != blank -%}
          <p class="trust-bar__title">{{ block.settings.title }}</p>
        {%- endif -%}
        {%- if block.settings.subtitle != blank -%}
          <p class="trust-bar__subtitle">{{ block.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

<style>
  .trust-bar {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: var(--space-6);
    padding: var(--space-10) var(--space-10);
    border-top: 0.5px solid var(--color-gray-200);
    border-bottom: 0.5px solid var(--color-gray-200);
    margin: var(--space-8) auto;
  }

  .trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .trust-bar__icon {
    width: 28px;
    height: 28px;
    color: var(--color-black);
  }

  .trust-bar__icon svg {
    width: 100%;
    height: 100%;
  }

  .trust-bar__title {
    font-family: var(--font-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    color: var(--color-black);
    margin: 0;
    line-height: 1.3;
  }

  .trust-bar__subtitle {
    font-family: var(--font-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
    color: var(--color-gray-500);
    margin: 0;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .trust-bar {
      grid-template-columns: repeat(2, 1fr);
      padding: var(--space-8) var(--space-5);
    }
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "store",      "label": "Boutique (Click & Collect)" },
            { "value": "badge",      "label": "Badge (Authentique)" },
            { "value": "truck",      "label": "Camion (Livraison)" },
            { "value": "headphones", "label": "Casque (SAV)" },
            { "value": "check",      "label": "Coche" }
          ],
          "default": "store"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Click & Collect"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sous-titre",
          "default": "Disponible en boutique"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "store",      "title": "Click & Collect",  "subtitle": "Disponible en boutique" } },
        { "type": "item", "settings": { "icon": "badge",      "title": "100% Authentiques", "subtitle": "Produits garantis originaux" } },
        { "type": "item", "settings": { "icon": "truck",      "title": "Livraison rapide",  "subtitle": "24/48h en France" } },
        { "type": "item", "settings": { "icon": "headphones", "title": "SAV réactif",       "subtitle": "Une question ? On répond" } }
      ]
    }
  ]
}
{% endschema %}
