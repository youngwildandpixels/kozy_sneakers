{%- comment -%}
  Hero slideshow homepage — fullwidth, image + CTA centré
  Paramètres : slides (image, titre, sous-titre, lien CTA, label CTA)
{%- endcomment -%}

<div class="hero-slideshow">
  {%- for block in section.blocks -%}
    <div
      class="hero-slide{% if forloop.first %} hero-slide--active{% endif %}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        <img
          src="{{ block.settings.image | image_url: width: 1920 }}"
          srcset="
            {{ block.settings.image | image_url: width: 768 }} 768w,
            {{ block.settings.image | image_url: width: 1200 }} 1200w,
            {{ block.settings.image | image_url: width: 1920 }} 1920w
          "
          sizes="100vw"
          alt="{{ block.settings.image.alt | escape }}"
          loading="eager"
          width="1920"
          height="900"
          class="hero-slide__img"
        >
      {%- else -%}
        <div class="hero-slide__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slide__img' }}
        </div>
      {%- endif -%}

      <div class="hero-slide__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}"></div>

      <div class="hero-slide__content">
        {%- if block.settings.subtitle != blank -%}
          <p class="hero-slide__subtitle">{{ block.settings.subtitle }}</p>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h2 class="hero-slide__title">{{ block.settings.title }}</h2>
        {%- endif -%}
        {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
          <a href="{{ block.settings.cta_link }}" class="hero-slide__cta btn--cta-overlay">
            {{ block.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slideshow__dots" aria-label="Navigation slides">
      {%- for block in section.blocks -%}
        <button
          class="hero-dot{% if forloop.first %} hero-dot--active{% endif %}"
          aria-label="Slide {{ forloop.index }}"
          data-index="{{ forloop.index0 }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<style>
  .hero-slideshow {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .hero-slide {
    display: none;
    position: relative;
    width: 100%;
    height: {{ section.settings.height }}px;
  }

  .hero-slide--active { display: block; }

  .hero-slide__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-slide__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-gray-100);
  }

  .hero-slide__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slide__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  .hero-slide__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-10);
    gap: var(--space-4);
  }

  .hero-slide__subtitle {
    font-family: var(--font-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-white);
    margin: 0;
  }

  .hero-slide__title {
    font-family: var(--font-primary);
    font-size: clamp(32px, 6vw, 72px);
    font-weight: var(--font-weight-black);
    line-height: 1.0;
    letter-spacing: -1px;
    color: var(--color-white);
    margin: 0;
    text-transform: uppercase;
  }

  .btn--cta-overlay {
    display: inline-block;
    background: var(--color-white);
    color: var(--color-black);
    border: 1.5px solid var(--color-white);
    border-radius: 0;
    font-family: var(--font-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 28px;
    transition: background 0.2s, color 0.2s;
    margin-top: var(--space-2);
  }

  .btn--cta-overlay:hover {
    background: transparent;
    color: var(--color-white);
    opacity: 1;
  }

  .hero-slideshow__dots {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-2);
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .hero-dot--active { background: var(--color-white); }

  @media (max-width: 768px) {
    .hero-slide {
      height: {{ section.settings.height_mobile }}px;
    }
    .hero-slide__title {
      font-size: clamp(24px, 8vw, 40px);
    }
  }
</style>

<script>
  (function() {
    const slideshow = document.querySelector('.hero-slideshow');
    if (!slideshow) return;

    const slides = slideshow.querySelectorAll('.hero-slide');
    const dots = slideshow.querySelectorAll('.hero-dot');
    if (slides.length <= 1) return;

    let current = 0;

    function goTo(index) {
      slides[current].classList.remove('hero-slide--active');
      dots[current].classList.remove('hero-dot--active');
      current = index;
      slides[current].classList.add('hero-slide--active');
      dots[current].classList.add('hero-dot--active');
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
    });

    setInterval(() => goTo((current + 1) % slides.length), {{ section.settings.autoplay_delay | times: 1000 }});
  })();
</script>

{% schema %}
{
  "name": "Hero Slideshow",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Hauteur desktop (px)",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 700
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Hauteur mobile (px)",
      "min": 300,
      "max": 600,
      "step": 20,
      "default": 500
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Délai autoplay (secondes)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sous-titre (au-dessus)",
          "default": "Nouvelle collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "DÉCOUVREZ LA SÉLECTION"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Lien du bouton"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texte du bouton",
          "default": "DÉCOUVRIR"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Opacité overlay (%)",
          "min": 0,
          "max": 70,
          "step": 5,
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
